    "test": "node bin/cli.js init --help"
  },
  "keywords": [
    "analytics",
    "ga4",
    "google-analytics",
    "microsoft-clarity",
    "clarity",
    "posthog",
    "consent",
    "gdpr",
    "cookie-banner",
    "cli",
    "scaffolder",
    "react",
    "vite",
    "nextjs",
    "remix",
    "astro"
  ],
  "author": "Vladyslav Didyk",
